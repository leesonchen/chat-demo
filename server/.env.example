# Public origin of the chat-demo frontend and API.
APP_ORIGIN=https://chat.example.com

# Optional shared WeChat auth service. Register this app's callback with it.
AUTH_SERVICE_ORIGIN=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# The existing Official Account AppID, used to match the login to the same accounts.
WECHAT_APP_ID=

# Optional Open Platform mobile application, with the WeChat Login capability.
# Bind it and the Official Account to the same Open Platform account.
WECHAT_MOBILE_APP_ID=
WECHAT_MOBILE_APP_SECRET=

# Generate with: openssl rand -base64 32
# Keep this key outside the database and back it up securely.
API_KEY_ENCRYPTION_KEY=

# Set to required to enforce membership expiry for cloud backup and restore.
MEMBERSHIP_MODE=off

# Optional runtime settings.
HOST=127.0.0.1
PORT=8091
DATA_DIR=./server/data
NODE_ENV=production

# Optional WeChat Native settlement for previously placed orders.
WECHAT_PAY_ENABLED=0
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_MERCHANT_KEY_FILE=
WECHAT_PAY_API_V3_KEY_FILE=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_PLATFORM_KEY_FILE=
