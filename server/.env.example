# Public origin of the chat-demo frontend and API.
APP_ORIGIN=https://chat.example.com

# Optional shared WeChat auth service. Register this app's callback with it.
AUTH_SERVICE_ORIGIN=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# The existing Official Account AppID, used to match the login to the same accounts.
WECHAT_APP_ID=

# Generate with: openssl rand -base64 32
# Keep this key outside the database and back it up securely.
API_KEY_ENCRYPTION_KEY=

# Enable preview or required only in an isolated verification environment until payment is integrated.
MEMBERSHIP_MODE=off

# Optional runtime settings.
HOST=127.0.0.1
PORT=8091
DATA_DIR=./server/data
NODE_ENV=production
